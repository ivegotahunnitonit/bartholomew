{
  "hosting": [
    {
      "site": "acn-26670",
      "public": "site",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "!**/.well-known/**",
        "**/node_modules/**",
        "**/*.pdf",
        "**/datasets/**",
        "**/confidential/**",
        "**/*PITCH*",
        "**/*DECK*"
      ],
      "rewrites": [
        {
          "source": "/verify",
          "destination": "/verify.html"
        },
        {
          "source": "/seals/verify/**",
          "destination": "/verify.html"
        },
        {
          "source": "/api/v1/**",
          "run": {
            "serviceId": "bartolomew-cloud-engine",
            "region": "us-central1"
          }
        },
        {
          "source": "/cloud-health",
          "run": {
            "serviceId": "bartolomew-cloud-engine",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/**",
          "run": {
            "serviceId": "acn-fastapi-backend",
            "region": "us-central1"
          }
        },
        {
          "source": "/verify/**",
          "run": {
            "serviceId": "acn-fastapi-backend",
            "region": "us-central1"
          }
        },
        {
          "source": "/docs",
          "destination": "/docs.html"
        },
        {
          "source": "/docs.html",
          "destination": "/docs.html"
        },
        {
          "source": "/sim-lab",
          "destination": "/sim-lab.html"
        },
        {
          "source": "/sim-lab.html",
          "destination": "/sim-lab.html"
        },
        {
          "source": "/control-plane",
          "destination": "/control-plane.html"
        },
        {
          "source": "/control-plane.html",
          "destination": "/control-plane.html"
        },
        {
          "source": "/investors",
          "destination": "/investors.html"
        },
        {
          "source": "/investors.html",
          "destination": "/investors.html"
        },
        {
          "source": "/leaderboard",
          "destination": "/leaderboard.html"
        },
        {
          "source": "/leaderboard.html",
          "destination": "/leaderboard.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/.well-known/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/llms*.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },

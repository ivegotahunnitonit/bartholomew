FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY python_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY standalone_btp_verifier.py ./standalone_btp_verifier.py
COPY BTP_CONFORMANCE_SUITE.json ./BTP_CONFORMANCE_SUITE.json
COPY .well-known/ ./.well-known/
COPY python_backend/app/ ./app/
COPY python_backend/bartholomew_eval/ ./bartholomew_eval/

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]

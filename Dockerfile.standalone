FROM python:3.11-slim

WORKDIR /app

# Install system dependencies & Go
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential git golang-go \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Expose HTTP & WebSocket ports
EXPOSE 8000 8085

# Start Uvicorn Telemetry Gateway & Golang Daemon
CMD ["python", "-m", "uvicorn", "python_backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]

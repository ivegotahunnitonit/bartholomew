{
  "$schema": "https://glama.ai/mcp/schema/v1.json",
  "name": "bartholomew",
  "displayName": "Bartholomew Autonomous AI Guard",
  "description": "Sub-35µs in-process AST security gate, machine discovery manifest (.well-known/btp.json), secret scrubber, delegation chains, dispute arbitration, and L402 Lightning settlement for AI agent swarms.",
  "version": "5.4.14",
  "homepage": "https://bartholomew.info",
  "repository": "https://github.com/ivegotahunnitonit/bartholomew",
  "categories": ["security", "developer-tools", "ai-safety"],
  "license": "MIT",
  "mcp": {
    "protocol": "stdio",
    "command": "python",
    "args": ["mcp_server.py"],
    "env": {
      "PYTHONUNBUFFERED": "1"
    }
  },
  "npx": {
    "command": "npx",
    "args": ["-y", "btp-guard", "mcp", "run"]
  }
}

# ══════════════════════════════════════════════════════════════
#  ACN Node Configuration  —  .env.example
#  Copy this file to .env and edit the values for your setup.
#  Lines starting with # are comments and are ignored.
# ══════════════════════════════════════════════════════════════


# ── Server ────────────────────────────────────────────────────

# TCP port the ACN Node HTTP/REST server listens on.
# The dashboard is served at http://localhost:<PORT>
PORT=8080


# ── Geolocation ───────────────────────────────────────────────

# Your physical latitude and longitude (decimal degrees).
# Used for proximity-based matching of materials offers/requests.
LAT=40.7128
LNG=-74.0060


# ── P2P Network ───────────────────────────────────────────────

# Comma-separated list of peer node URLs to connect to on startup.
# Leave empty to start an isolated node (useful for local testing).
# Example: BOOTSTRAP_PEERS=http://node1.example.com:8080,http://node2.example.com:8080
BOOTSTRAP_PEERS=


# ── Economics ─────────────────────────────────────────────────

# Fee rate applied to matched transactions, expressed as a decimal fraction.
# 0.01 = 1%,  0.005 = 0.5%,  0 = no fee
FEE_RATE=0.01


# ── Identity ──────────────────────────────────────────────────

# Human-readable display name for this node on the network.
# Visible to peer nodes and shown in the dashboard.
NODE_NAME=ACN-Node-Local


# ── Storage ───────────────────────────────────────────────────

# Directory where the node's SQLite database and wallet are stored.
# Defaults to ./data relative to the project root.
DATA_DIR=./data


# ── Logging ───────────────────────────────────────────────────

# Log verbosity level: error | warn | info | debug
LOG_LEVEL=info
